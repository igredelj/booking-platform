    "logo": "/tenants/skywing/logo.svg"
  },
  "theme": {
    "colors": {
      "primary": "#070316",
      "primaryText": "#FFFFFF",
      "background": "#F8F8FA",
      "surface": "#FFFFFF",
      "border": "#DEDDE4",
